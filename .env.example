# ==============================================================================
# RoadSense AI — Environment Variables Template
# Copy this file to `.env` and fill in your private credentials.
# ==============================================================================

# TomTom Traffic API (16-City Indian Metro Telemetry)
TOMTOM_API_KEY=your_tomtom_api_key_here
NEXT_PUBLIC_TOMTOM_API_KEY=your_tomtom_api_key_here

# Groq / LLM API (Agentic AI Operations Controller)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Smartcar IoT API (Connected Vehicle Telematics & OEM OAuth 2.0)
SMARTCAR_CLIENT_ID=your_smartcar_client_id_here
SMARTCAR_CLIENT_SECRET=your_smartcar_client_secret_here
SMARTCAR_REDIRECT_URI=http://localhost:3001/api/v1/smartcar/exchange
SMARTCAR_MODE=test
WEB_APP_URL=http://localhost:3000

# Apache Kafka Streaming Cluster
KAFKA_BROKERS=localhost:9092
TELEMETRY_TOPIC=vehicle.telemetry

# PostgreSQL / TimescaleDB Database
PG_HOST=localhost
PG_PORT=5432
POSTGRES_USER=roadsense
POSTGRES_PASSWORD=roadsense_password_here
POSTGRES_DB=roadsense

# Redis In-Memory Cache
REDIS_URL=redis://localhost:6379

# Fastify API Server
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/v1/live
